{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ESNext.Decorators"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["server-cli-web/files/src/**/*.ts", "server-cli-web/files/src/**/*.tsx"]
}
