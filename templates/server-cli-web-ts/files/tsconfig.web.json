{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client 提供 import.meta.glob 的类型 —— 页面自动发现靠它，缺了就报
    // 「Property 'glob' does not exist on type 'ImportMeta'」。
    "types": ["node", "vite/client"],
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/web.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
