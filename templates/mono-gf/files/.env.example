# 可选的覆盖文件：cp .env.example .env 之后按需改。
#
# docker-compose.yml 里每个变量都写了 ${VAR:-默认值}，所以**不建 .env 也能跑**；
# 这个文件的用途是「不改 compose、不改配置，只改运行参数」。
#
# ⚠️ .env 已在 .gitignore 里：它将来会放真实口令，不该进仓库。

# 容器名前缀，便于同机跑多个实例时区分
APP_NAME={{name}}

# PostgreSQL
PG_DATABASE={{pgDatabase}}
PG_USER={{pgUser}}
PG_PASSWORD={{pgPassword}}
PG_PORT={{pgPort}}

# 端口映射（容器内端口固定，这里改的是宿主机侧）
API_PORT={{apiPort}}
WEB_PORT={{webPort}}
