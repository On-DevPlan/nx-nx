{
  "name": "{{name}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "type": "module",
  "bin": {
    "{{name}}": "bin/{{letters}}.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/{{letters}}.mjs serve --no-open",
    "start": "pnpm run build && node bin/{{letters}}.mjs serve",
    "link:local": "node scripts/link-local.mjs",
    "unlink:local": "node scripts/link-local.mjs --unlink",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/{{name}}.git"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "vite": "^6.0.7"
  }
}
