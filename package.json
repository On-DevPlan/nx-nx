{
  "name": "nx-nx",
  "version": "0.1.0",
  "description": "nx-xx 项目生成器 — 把 server-cli-web 骨架物化成模板：输入两个字母，生成一个开箱可用的 CLI + Web 面板项目",
  "type": "module",
  "bin": {
    "nx-nx": "bin/nx-nx.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node bin/nx-nx.mjs serve --no-open",
    "start": "pnpm run build && node bin/nx-nx.mjs serve",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "logo": "node tools/logo-gen/cli.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-nx.git"
  },
  "keywords": [
    "scaffold",
    "cli",
    "web-panel",
    "generator",
    "nx"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "vite": "^6.0.7"
  }
}
