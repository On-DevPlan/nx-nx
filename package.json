{
  "name": "nx-nx",
  "version": "0.5.1",
  "description": "nx 系列项目生成器 — 把 server-cli-web 骨架物化成项目：CLI 与 Web 面板同源，提供 JS 与 TypeScript 两套模板（TS 模板带编译期类型安全）",
  "type": "module",
  "bin": {
    "nx-nx": "bin/nx-nx.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b --force tsconfig.node.json && vite build",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:serve": "node --import tsx src/runtime/cli.ts serve --no-open",
    "start": "pnpm run build && node bin/nx-nx.mjs serve",
    "lint": "eslint .",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:smoke && pnpm run test:unit",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-nx.git"
  },
  "keywords": [
    "scaffold",
    "cli",
    "web-panel",
    "generator",
    "nx"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.7"
  }
}
